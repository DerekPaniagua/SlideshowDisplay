# Screen and monitoring settings for the office display.
# Edit from any computer (this file is on the SD card), then reboot or run: slideshow restart-screen

# Rotation: normal, 90, 180 or 270. Use 90 or 270 for portrait, whichever is right side up.
DISPLAY_TRANSFORM=90

# Resolution: blank uses the TV's preferred mode. Run `slideshow display` to see supported modes.
# Examples: 3840x2160@60Hz   3840x2160@30Hz (lighter on the Pi)   1920x1080@60Hz (lightest)
DISPLAY_MODE=

# Scale: 2 for 4K, 1 for 1080p. The layout adapts either way; this only affects sharpness.
DISPLAY_SCALE=2

# Output name, blank = first connected display (e.g. HDMI-A-1)
DISPLAY_OUTPUT=

# Extra Chromium flags for performance experiments, e.g. --ignore-gpu-blocklist
CHROMIUM_EXTRA_FLAGS=

# Uptime alert URL, e.g. https://hc-ping.com/your-check-id (free at healthchecks.io). Blank = off.
HEARTBEAT_URL=

# Nightly reboot time (24-hour HH:MM). Blank = never.
NIGHTLY_REBOOT=03:30
